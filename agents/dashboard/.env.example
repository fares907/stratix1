# Supabase → Project Settings → API
# المفتاح ده (anon) معمول عشان يبقى في المتصفح؛ الحماية الحقيقية هي RLS في قاعدة البيانات.
# عمرك ما تحط service_role هنا.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only (للتليجرام بس) — مش NEXT_PUBLIC، فمابيوصلش للمتصفح
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=   # أي كلام عشوائي طويل

# مفاتيح الموديلات (server-only) — عشان الشات مع الموظفين من اللوحة
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
